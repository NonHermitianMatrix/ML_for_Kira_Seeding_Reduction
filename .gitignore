# Local tools and TeX cache are present on Hoffman but not versioned.
.tools/

# Generated LaTeX build files; retain the rendered PDF in Git.
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.toc

# Disposable Kira databases and scheduler logs. Validation records are versioned.
Master_Integrals/.work/
Master_Integrals/logs/
Master_Integrals/**/__pycache__/
Master_Integrals/**/*.part

# Kira writes a version log in the current directory.
/kira.log

Expanded_Integrals/.work/
Expanded_Integrals/logs/
Expanded_Integrals/__pycache__/

Expanded_Integrals/families/*.part

Expanded_Integrals/individual_targets/*.part
