# Tools, caches, scheduler output and temporary work stay on Hoffman.
.tools/

# Keep the rendered report; ignore LaTeX build intermediates.
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.toc

# Kira version output.
/kira.log

# Keep all completed integral data.
integrals/**/__pycache__/
integrals/__pycache__/
integrals/**/*.part

# Seed-model caches and unfinished output.
ML_model_seed_selection/__pycache__/
ML_model_seed_selection/**/*.part
